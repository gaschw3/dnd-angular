{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "outDir": "../out-tsc/app",
    "strictPropertyInitialization": false,
    "paths": {
      "src/*": ["./*"]
    },
    "types": []
  },
  "files": [
    "main.ts"
  ],
  "include": [
    "**/*.d.ts",
    "app/**/*.ts"
  ],
  "exclude": [
    "**/*.spec.ts"
  ]
}
